# Hopkins statistic
set.seed(123123)
run_hopkins <- function(source_data, name) {
structure(
get_clust_tendency(source_data, n = nrow(source_data) - 1, graph = FALSE)$hopkins_stat,
dataset = name,
metric = attributes(source_data)$metric, #if it doesn't have a metric, this will                                              # be ignored
