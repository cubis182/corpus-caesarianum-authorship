}
gorman_best_set <- gorman.vars[,c("title", best_set)] |> column_to_rownames("title")
test <- kmeans(gorman_best_set, centers = 3, nstart = 50)
title <- "Minimum within Cicero dissimilarity plus minimum within Sallust dissimilarity and dissimilarity between Sallust / all others"
fviz_cluster(test, gorman_best_set) + labs(title = title)
gorman_dist <- get_dist(gorman_best_set, method = "spearman")
graph <- plot_dist_corpus_project(gorman_dist, gorman_best_set) + labs(title = title)
graph + theme(axis.text = element_text(size = 4))
