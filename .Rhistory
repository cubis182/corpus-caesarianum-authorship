methods <- c(
"pearson",
"spearman",
"kendall", #
"euclidean",
#"maximum", # Only considers the distance between the farthest parts of each vector. This results in MORE clusters, but we want to be conservative and account for even low-frequency variables.
"manhattan",
#"canberra", # Will only use Canberra for section-by-section variables, since it is good with sparse vectors
#"binary", # Proportion of values in the vector which are above 0; worthless for the book-by-book variables
"minkowski"
)
for (method in methods) {
tmp <- object %>%
map(\(x) custom_dist(x, method = method)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- method
.x
})
metrics %<>% c(tmp)
}
# minmax
tmp <- object %>%
map(\(x) custom_dist(x, method = minmax)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- "minmax"
.x
})
metrics %<>% c(tmp)
fan_res <- fanny((metrics |> keep(~ attributes(.x)$metric == "pearson" && attributes(.x)$dataset == 3))[[1]], 2)
fviz_cluster(fan_res, object$gorman,
ellipse.type = "norm",   # normal-distribution concentration ellipse
repel = TRUE,            # keep state labels from overlapping
palette = "jco",         # colourblind-safe journal palette
ggtheme = theme_minimal(),
legend = "right")
fviz_silhouette(fan_res)
str(fan_res)
fan_res <- fanny((metrics |> keep(~ attributes(.x)$metric == "pearson" && attributes(.x)$dataset == 3))[[1]], 2)
fviz_cluster(fan_res, object$gorman,
ellipse.type = "norm",   # normal-distribution concentration ellipse
repel = TRUE,            # keep state labels from overlapping
palette = "jco",         # colourblind-safe journal palette
ggtheme = theme_minimal(),
legend = "right") + geom_label(aes(label = fan_res$membership[,1]))
fviz_silhouette(fan_res)
