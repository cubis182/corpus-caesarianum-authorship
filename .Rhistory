bg1bc_dist <- get_dist(bg1bc, method = params$dist_method)
fviz_dist(bg1bc_dist, show_labels = FALSE)
fclust::VAT(bg1bc)
# Get location of largest dissimilarity
mat_bg1 <- as.matrix(bg1bc_dist)
# Get location of largest dissimilarity
mat_bg1bc <- as.matrix(bg1bc_dist)
rm(mat_bg1)
View(mat_bg1bc)
View(mat_bg1bc["gallic_1_1",])
# Get location of largest dissimilarity
mat_bg1bc <- as.matrix(bg1bc_dist)["gallic_1_1",]
largest <- min(mat_bg1[mat_bg1 > 0])
smallest <- min(mat_bg1bc[mat_bg1bc > 0])
name(smallest)
names(smallest)
smallest
names(mat_bg1bc[mat_bg1bc == smallest])
