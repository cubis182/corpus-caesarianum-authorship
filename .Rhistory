# cophenetic correlation coefficient; if the correlation isn't high, we have more reason to disregard the data
cophenetic_results <- map(
metrics,
\(x) {
cophenetic(hclust(x, method = "ward.D2"))
}
)
coph_coefficients <- imap_dbl(unname(metrics), \(x, y) cor(x, structure(cophenetic_results[[y]], dataset = attributes(x)$dataset, metric = attributes(x)$metric, )))
length(cophenetic_results)
length(metrics)
coph_coefficients <- imap_dbl(unname(metrics), \(x, y) cor(x, structure(cophenetic_results[[y]], dataset = attributes(x)$dataset, metric = attributes(x)$metric)))
