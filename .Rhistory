var <- source_data[[colname]]
# For each variable, paste it with the *n* following items in the sequence.
# na.omit() ensures anything indexed past the end is discarded
imap_chr(var, ~ {
# browser()
paste(na.omit(var[.y:(.y + n)]), sep = "|")
})
}
