gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
# for this next adjustment, see Obsidian notebook 8/29/2026
# gorman.vars <- gorman.vars[,subset_of_corpus]
# I have decided to z-standardize instead 9/26/2026
# gorman.vars %<>% scale_df()
gorman.vars <- gorman.vars[,subset_of_corpus]
gorman.vars %<>% reorder_works()
gorman.vars$title <- lookup_table[gorman.vars$title]
gorman.vars %<>% column_to_rownames("title")
rownames(object$caesar_gorman) <- lookup_table[rownames(object$caesar_gorman)]
# Try standardizing?
km_res <- kmeans(gorman.vars, 3, nstart = 50)
km_caesar_only <- kmeans(object$caesar_gorman, 2, nstart = 50)
# attempting to use the more restricted variable set
fviz_cluster(km_res, gorman.vars, repel = TRUE, stand = FALSE, palette = cbbPalette) +
labs(title = "Cluster plot of the *Corpus Caesarianum*, Sallust, and Cicero.")
ggsave("./Images/august-draft/cicero_caesar_split.png", dpi = "print")
fviz_cluster(km_caesar_only, object$caesar_gorman, repel = TRUE, palette = cbbPalette) +
labs(title = "Cluster plot of the *Corpus Caesarianum* in two clusters")
if (!is.null(gorman.vars$title)) gorman.vars <- gorman.vars %>% mutate(title = lookup_table[title]) %>% column_to_rownames("title")
gorman_dist <- get_dist(gorman.vars, method = "spearman")
dist_palette <- brewer.pal(n = 5, "YlOrRd")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph <- plot_dist_corpus_project(gorman_dist, gorman.vars) + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
