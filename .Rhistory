metrics %<>% c(tmp)
# Default methods
methods <- c(
"pearson",
"spearman",
"kendall",
"euclidean",
"maximum",
"manhattan",
"canberra",
"binary",
"minkowski"
)
for (method in methods) {
tmp <- object %>%
map(\(x) custom_dist(x, method = method)) %>%
unname()
tmp %<>% iwalk(\(.x, .y) mostattributes(.x) <- list(dataset = .y, metric = method))
metrics %<>% c(tmp)
}
