graph <- plot_dist_corpus_project(gorman_dist.2, gorman.vars.2) +
labs(title = "Dissimilarity scores between a", subtitle = "Scores computed with Spearman's ρ") +
theme(axis.title = element_markdown())
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05), limits = c(0, 0.8))
ggsave("Images/dissimilarity_matrix_between_books_by_correlation-2.png", dpi = "print")
