#nselectboot
run_nselectboot <- function(source_data, name) {
structure(
nselectboot(
source_data,
B = 50,
clustermethod = kmeansCBI,
classification = "centroid",
krange = CLUSTERS,
count = TRUE,
largeisgood = TRUE
)
)
}
