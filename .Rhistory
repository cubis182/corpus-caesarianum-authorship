map(\(x) custom_dist(x, method = minmax)) %>%
unname()
tmp %<>% iwalk(\(.x, .y) mostattributes(.x) <- list(dataset = .y, metric = "minmax"))
metrics %<>% c(tmp)
as.hclust(metrics[[1]])
