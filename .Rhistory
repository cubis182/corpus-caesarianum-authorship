}
scores <- c(scores, final_stat)
}
}
gorman_best_set <- gorman.vars[,c("title", best_set)] |> column_to_rownames("title")
test <- kmeans(gorman_best_set, centers = 3, nstart = 50)
fviz_cluster(test, gorman_best_set) + labs(title = "(1 - max(Cicero dist))) + (1 - max(Sallust dist)) + min(Caesar to Cicero dist")
gorman_dist <- get_dist(gorman_best_set, method = "pearson")
graph <- plot_dist_corpus_project(gorman_dist, gorman_best_set)
graph + theme(axis.text = element_text(size = 4))
