#These indices currently only select Caesar
mat <- as.matrix(gorman_dist)
caesar_counts <- as_tibble(mat[21:35,21:35]) |> rowwise() |> mutate(means = mean(c_across(1:13)))
caesar_counts$title <- colnames(caesar_counts)[-15]
gallic_counts <- as_tibble(mat[27:34,27:34]) |> rowwise() |> mutate(means = mean(c_across(1:8)))
gallic_counts$title <- colnames(gallic_counts)[-9]
col1 <- rep(dimnames(mat)[[1]], times = length(dimnames(mat)[[1]]))
col2 <- rep(dimnames(mat)[[1]], each = length(dimnames(mat)[[1]]))
df <- tibble(col1 = col1, col2 = col2)
df %<>% rowwise() %>%
mutate(
pvalue = t.test(
mat[unlist(col1),],
mat[unlist(col2),])$p.value
)
df %<>% pivot_wider(names_from = col2, values_from = pvalue)
df
View(df)
print(
map_dbl(scores.correlation.per.text, ~ wilcox.test(.x)$p.value)
)
hist(scores.correlation.per.text$brutus_1)
longest <- map_int(scores.correlation.per.text, ~ length(.x)) %>% max()
even_out <- function(.x) {
if(length(.x) < longest) {
c(.x, rep(NA, longest - length(.x)))
} else .x
}
scores.correlation.per.text %<>% map(even_out)
diss_scores_df <- do.call(data.frame, scores.correlation.per.text)
diss_scores_pivoted <- diss_scores_df %>% pivot_longer(cols = everything(), names_to = "title", values_to = "dissimilarities", values_drop_na = TRUE)
ggplot(diss_scores_pivoted, aes(title, dissimilarities)) + geom_boxplot() + theme(axis.text.x = element_text(angle = 90, hjust = 1.0))
# How significant is what we observe in the above graph, that Caesar and Sallust tend to have a lower ? We can also use a one tailed test. Our hypothesis is that the first set, the works of Cicero, have a higher distribution of dissimilarity scores than Caesar and Sallust. The null hypothesis we must reject to prove this is that the Cicero's scores are lower.
ks.test(
# Cicero
jitter(na.omit(unlist(scores.correlation.per.text[
names(scores.correlation.per.text) %notin% c(
caesar_works_v,
"catilinae_sallusti",
"iugurthine_1"
)
]))),
# Caesar and Sallust
jitter(na.omit(unlist(scores.correlation.per.text[
names(scores.correlation.per.text) %in% c(
caesar_works_v,
"catilinae_sallusti",
"iugurthine_1"
)
]))),
alternative = "less"
)
# We can confidently reject the null hypothesis with a significant p-value of less than 2.2e-16
?ks.test
dissimilarity_median <- map(scores.correlation.per.text, ~ median(.x, na.rm = TRUE))
print(sort(unlist(dissimilarity_median)))
#Get a vector of all the titles2
titles <- unique(sectioned.gorman.vars$path)
#Get the spearman correlation coefficients, add them to a list, with the label being the title
scores.correlation.per.text <- tapply(sectioned.gorman.vars, INDEX = sectioned.gorman.vars$path, FUN = within.book.similarity, rows = 20, type_of_similarity = "spearman")
names(scores.correlation.per.text) <- titles
# NOTE: REDUCING TO VARIABLES 250-500 GETS RESULTS VERY SIMILAR TO WHAT WE GOT WITH THE FULL DATASET, INCLUDING PARENTS, BEFORE; PERHAPS REMOVING THE MOST AND LEAST COMMON WILL HELP MAKE THE PICTURE LESS MUDDY?
if (!is.null(gorman.vars$title)) gorman.vars <- gorman.vars %>% mutate(title = lookup_table[title]) %>% column_to_rownames("title")
gorman_dist <- get_dist(gorman.vars, method = params$dist_method)
#gorman_dist <- proxy::dist(gorman.vars |> dplyr::select(-title), method = "cosine")
#gorman_dist <- get_dist(gorman.vars |> dplyr::select(-title), method = "euclidean")
dist_palette <- brewer.pal(n = 5, "BrBG")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph <- plot_dist_corpus_project(gorman_dist, gorman.vars) + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
graph
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = 0.3)
ggsave("Images/dissimilarity_matrix_between_books.png", dpi = "print")
#View(as.data.frame(as.matrix(gorman_dist)))
quantile(unlist(scores.correlation.per.text), probs = 0.05)
quantile(unlist(scores.correlation.per.text), probs = 0.95)
quantile(unlist(scores.correlation.per.text), probs = 0.5)
hist(scores.correlation.per.text)
hist(unlist(scores.correlation.per.text))
wilcox.test(unlist(scores.correlation.per.text))
