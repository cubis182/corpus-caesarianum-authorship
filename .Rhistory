stat_sallust <- gorman_dist[sallust_all,c(cicero_all, caesar_all)] %>% min(na.rm = TRUE)
final_stat <- sum(c(stat_cicero, stat_caesar, stat_sallust))
if (final_stat > max(scores)) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
}
