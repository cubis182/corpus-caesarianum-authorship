fan_res$membership %>% as.data.frame() %>% rownames_to_column("title") %>% pivot_longer(cols = -title, names_to = "group", values_to = "value")
test <- fan_res$membership %>% as.data.frame() %>% rownames_to_column("title") %>% pivot_longer(cols = -title, names_to = "group", values_to = "value")
ggplot(test, aes(x = group, y = value, fill = title)) + geom_col(position = "stack") + theme_minimal()
ggplot(test, aes(x = title, y = value, fill = group)) + geom_col(position = "stack") + theme_minimal()
