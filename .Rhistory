custom_fviz_clust <- function (km_result, source_data = NULL) {
labs_kmeans <- lookup_table[rownames(source_data)]
fviz_cluster(object = km_result,
source_data,
stand = FALSE,
palette = palette,
geom = geom,
ellipse.type = ellipse.type,
ggtheme = ggtheme
) +
geom_text_repel(
aes(label = labs_kmeans),
vjust = "inward",
hjust = "inward",
max.overlaps = 14,
size = 2,
seed = 12927
) +
labs(
title = glue::glue("{names(km_result)}")
) +
theme(axis.title = element_text(size = 12))
}
# NOTE: Apply all of these to each frequency measurement used in the previous code block.
# Create a new dissimilarity OR similarity matrix with each distance metric
metrics <- list()
# Removed cosine 8/19/2026, see notes below
# Default methods
methods <- c(
"pearson",
"spearman",
"kendall", #
"euclidean",
#"maximum", # Only considers the distance between the farthest parts of each vector. This results in MORE clusters, but we want to be conservative and account for even low-frequency variables.
"manhattan",
#"canberra", # Will only use Canberra for section-by-section variables, since it is good with sparse vectors
#"binary", # Proportion of values in the vector which are above 0; worthless for the book-by-book variables
"minkowski"
)
for (method in methods) {
tmp <- object %>%
map(\(x) custom_dist(x, method = method)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- method
.x
})
metrics %<>% c(tmp)
}
# minmax
tmp <- object %>%
map(\(x) custom_dist(x, method = minmax)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- "minmax"
.x
})
metrics %<>% c(tmp)
# Agglomerative clustering (use AGNES, put the agglomerative coefficient somewhere visible)
# If we add the linkage methods "flexible" or "gaverage", we would have to be familiar with the Lance-Williams formula and parameters, and I do not trust my expertise in that regard. See the documentation for the `agnes()` function.
run_agnes <- function(dist) {
structure(
agnes(dist, method = "ward"),
dataset = names(object)[attributes(dist)$dataset],
algorithm = "agnes",
metric = attributes(dist)$metric,
linkage = "ward"
)
}
agnes_results <- map(metrics, run_agnes)
# What is the average agglomerative coefficient for each linkage method? This will help decide which linkage method is best for pvclust down below.
ac_values <- list(linkage = character(), ac = double(), dataset = character(), metric = character())
for (item in agnes_results) {
ac_values$linkage <- c(ac_values$linkage, attributes(item)$linkage)
ac_values$ac <- c(ac_values$ac, item$ac)
ac_values$dataset <- c(ac_values$dataset, attributes(item)$dataset)
ac_values$metric <- c(ac_values$metric, attributes(item)$metric)
}
ac_values <- as.data.frame(ac_values)
ac_values |> group_by(linkage) |> summarize(mean = mean(ac)) |> ggplot(aes(linkage, mean)) + geom_col()
# This graph shows that each linkage method is roughly equivalent, although Ward gives the largest average agglomerative coefficient by a very small margin. Since all are so similar and consistent (no value below 0.9 is reported for any data set), I feel confident using only ward for pvclust. We can remove the others.
# agnes_results %<>% discard(~ attributes(.x)$linkage != "ward")
# The worst metric for agglomerative coefficient is cosine, while the highest is Pearson's r. Euclidean distance does fairly well, with the minimum AC being 0.87 if we discount the `caesar_simplex` dataset as an outlier. Maximum is the same story, hovering around 0.9 other than `caesar_simplex`. Canberra always gets a low value when only considering Caesar. Manhattan distance has a similar problem, but it never has a lower AC than about 0.6.
# COMPARE DENDROGRAMS GENERATED FROM THESE DISTANCE METRICS NUMERICALLY
# pvclust allows you to create and visualize p-values for hierarchical clusters!
# install.packages(pvclust)
# library(pvclust)
# Testing ALL methods is quite slow, so we might want to see which method got the best performance in AGNES first. I could parallelize the function, but the use of "custom_dist" begins to get us into a world of figuring out R internals and making sure the value associated with "custom_dist" actually gets passed to the function correctly.
# I will do this with only correlation distance for pvclust to save on computation time, especially given what we saw in the code blocks above and the challenges with cosine similarity.
pvclust_results <- c(
imap(
object[3:4],
\(x, y) structure(pvclust(t(x), "ward.D2", "correlation"), dataset = y, method = "ward.D2", metric = "correlation")
)
