aes(x = x_axis, y = y_axis, fill = value),
inherit.aes = FALSE
) +
geom_text(
data = d_long,
aes(x = x_axis, y = y_axis, label = value),
color = "black",
size.unit = "pt",
size = 4,
inherit.aes = FALSE)
dist_palette <- brewer.pal(n = 5, "YlOrRd")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = 0.3)
ggsave("Images/dissimilarity_matrix_between_books.png", dpi = "print")
#View(as.data.frame(as.matrix(gorman_dist)))
?get_dist
feature_set_sizes <- seq(from = 25, to = 500, by = 25)
n_trials <- 10000
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
for (sample_n in feature_set_sizes) {
for (trial in 1:n_trials) {
features <- sample(colnames(gorman.vars %>% select(where(is.numeric))), size = sample_n)
sub_gorman.vars <- gorman.vars %>%
column_to_rownames("title")  %>%
select(all_of(features))
# NOTE: use Euclidean because I am more interested in MAXIMIZING DISTANCE between clusters
gorman_dist <- get_dist(sub_gorman.vars, method = "euclidean") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- gorman_dist[caesar_all,c(cicero_all, sallust_all)] %>% min(na.rm = TRUE) # na.rm shouldn't be necessary...
stat_cicero <- gorman_dist[cicero_all,c(caesar_all, sallust_all)] %>% min(na.rm = TRUE)
stat_sallust <- gorman_dist[sallust_all,c(cicero_all, caesar_all)] %>% min(na.rm = TRUE)
final_stat <- sum(c(stat_cicero, stat_caesar, stat_sallust))
if (final_stat > suppressWarnings(max(scores))) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
}
