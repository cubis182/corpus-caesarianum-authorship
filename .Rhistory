# fpc::clusterbenchstats using a variety of clusterings
CLUSTERS <- 2:7
# Notes from Akhanli and Hennig 2020, which is the inspiration for this function:
#> The user is expected to choose the indices that best fit their goals, not just all of the options
#> Some indices focus on cluster homogeneity, others on separation of clusters, and others on cluster stability. All of these are not usually helpful for every situation.
run_cbs <- function(source_data) {
# cmp <- list()
# cmp[1:4] <- list()
cbs <- clusterbenchstats(
source_data,
CLUSTERS,
clustermethod = c("kmeansCBI"), # , "hclustCBI", "hclusttreeCBI", "claraCBI", "tclustCBI"),
clustermethodpars = list(list(runs = 5, criterion = "asw")),
#methodnames = , # using default parameter here
distmethod = c(FALSE), #, FALSE, FALSE, TRUE, FALSE),
ncinput = c(TRUE), #, TRUE, FALSE, FALSE, TRUE),
useboot = TRUE,
bootclassif = c("centroid"), #, ),
bootmethod = "nselectboot",
bootruns = 5
)
}
system.time(cbs_res <- run_cbs(object$gorman))
cbs_res
cbs_res
