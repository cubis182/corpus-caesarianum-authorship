library(ggdendro)
library(fclust)
library(lsa)
library(fpc)
conflict_prefer("filter", "dplyr")
conflicted::conflicts_prefer(combinat::combn)
conflicted::conflicts_prefer(dplyr::select)
#For debugging purposes, here is a vector to save the size of the lower quartile that is discarded when variables are counted. This number is the minimum number of times per 1000 words a variable can occur in that section without getting discarded
lower_quartiles <- vector(mode = "double")
log_threshold(level = DEBUG)
source("functions.R")
simplex_vars_only <- read.csv("./feature_csv_files/feature_values.csv")
file.vars.gorman <- if (params$use_parent) "./feature_csv_files/feature_values_gorman.csv" else "./feature_csv_files/feature_values_wordonly.csv"
gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
file.sectioned.gorman <- if (params$use_parent) "./feature_csv_files/feature_values_gorman_by_section.csv" else "./feature_csv_files/feature_values_wordonly_by_section.csv"
sectioned.gorman.vars <- read.csv("./feature_csv_files/feature_values_gorman_by_section.csv");sectioned.gorman.vars$title <- gsub(" ", "", sectioned.gorman.vars$title)
# Add new feature set here, both book-by-book and section-by-section
# Add new feature set COMBINED with morph n-grams (without parent features or Deprel)
custom_vars_book <- read.csv("feature_csv_files/feature_values_custom_by_book.csv")
custom_vars_section <- read.csv("feature_csv_files/feature_values_custom_by_section.csv")
cicero_works <- "(philippics|senectute|amicitia|brutus|deiotaro)"
# move Cicero to the end, to keep authors separated
sectioned.gorman.vars <- bind_rows(
filter(sectioned.gorman.vars, str_starts(title, cicero_works)),
filter(sectioned.gorman.vars, !str_starts(title, cicero_works))
)
gorman.vars <- bind_rows(
filter(gorman.vars, str_starts(title, cicero_works)),
filter(gorman.vars, !str_starts(title, cicero_works))
)
#For converting to readable names in graph labels.
lookup_table <- setNames(
c("BAlex. 1-21", "BAlex. 22-78", "BAfr.", "De Amicitia", "BC 1", "BC 2", "BC 3", "BG 1", "BG 2", "BG 3", "BG 4", "BG 5", "BG 6", "BG 7", "BG 8", "Philippics 1", "Philippics 2", "Philippics 3", "Philippics 4", "Philippics 5", "Philippics 6", "Philippics 7", "Philippics 8", "Philippics 9", "Philippics 10", "Philippics 11", "Philippics 12", "Philippics 13", "Philippics 14", "De Senectute", "BHisp."),
c("alexandrine_1", "alexandrine_2", "african_1", "amicitia_1", "civil_1", "civil_2", "civil_3", "gallic_1", "gallic_2", "gallic_3", "gallic_4", "gallic_5", "gallic_6", "gallic_7", "gallic_8", "philippics_1", "philippics_2", "philippics_3", "philippics_4", "philippics_5", "philippics_6", "philippics_7", "philippics_8", "philippics_9", "philippics_10", "philippics_11", "philippics_12", "philippics_13", "philippics_14", "senectute_1", "spanish_1")
)
# Set up a data structure we can add the results to.
object <- list(
simplex_vars_only,
gorman.vars,
custom_vars_book,
#sectioned.gorman.vars
)
# Set up a data structure we can add the results to.
object <- list(
simplex_vars_only,
gorman.vars,
custom_vars_book
#sectioned.gorman.vars
)
# We need to add rownames, then convert each to a matrix. This will prepare us for some of the functions coming up, which assume an entirely numeric dataset and assume rownames for graphing and generating a dist object
object %<>% map(~ column_to_rownames(.x, "title"))
object %<>% map(~ as.matrix(.x))
# Add each to a named list
object %<>% map(~ list(.x))
names(object) <- c("simplex", "gorman", "custom")#, "sectioned")
summary(object)
# NOTE: Apply all of these to each frequency measurement used in the previous code block.
# Create a new dissimilarity OR similarity matrix with each distance metric
# Cosine SIMILARITY matrix:
# lsa::cosine(m)
# Adds a new "cosine" list to each one; I transpose because it compares each COLUMN
tmp <- object %>% object_map(f = \(x) custom_dist(x, method = lsa::cosine), label = "cosine")
object <- tmp
rm(tmp)
# Default methods
methods <- c(
"pearson",
"spearman",
"kendall",
"euclidean",
"maximum",
"manhattan",
"canberra",
"binary",
"minkowski"
)
for (method in methods) {
object %<>% object_map(f = \(x) custom_dist(x, method = method), label = method)
}
# minmax
tmp <- object %>% object_map(f = \(x) custom_dist(x, method = minmax), label = "minmax")
object <- tmp
rm(tmp)
# Cosine delta
# Eder's Delta
# SPATIUM-L1
# We can use get_dist() with a variety of distance metrics
# COMPARE DENDROGRAMS GENERATED FROM THESE DISTANCE METRICS NUMERICALLY
fviz_cluster
# Some defaults for the following graphs
# Add this with the + operator to fviz_cluster plots. @param data is the original dataset used for cluster analysis (df_clust in the first case)
cluster_labels <- geom_text_repel(aes(label = rownames(data)), vjust = "inward", hjust = "inward", max.overlaps = 20, size = 3)
# Args for fviz_clust
palette <- c("#2E9FDF", "#00AFBB", "#E7B800", "red", "gray", "cyan", "black")
geom <- "point"
ellipse.type <- "convex"
ggtheme <- theme_bw()
# K-means
k <- 3
# Hcut
hc_func <- "agnes"
hc_method <- "ward"
hc_metric <- "euclidean"
cex <- 0.2
# Text labels for distance diagrams. @param label is usually the rownames of a data.frame
margin_size <- 10
distance_labels <- theme(axis.text = element_text(size = 5, vjust = 1), margins = margin(t = margin_size, r = margin_size, b = margin_size, l = margin_size))
# Dendrogram theme
dend_size <- 0.2
dend_theme <- theme(axis.text = element_text(size = dend_size, vjust = 1), margins = margin(t = margin_size, r = margin_size, b = margin_size, l = margin_size))
custom_fviz_clust <- function (object, data = NULL, choose.vars = NULL,
stand = TRUE, palette = palette, geom = geom,
ellipse.type = ellipse.type, ggtheme = ggtheme) {
labs_kmeans <- lookup_table[data$title]
fviz_cluster(object,
data,
choose.vars = choose.vars,
stand = FALSE,
palette = palette,
geom = geom,
ellipse.type = ellipse.type,
ggtheme = ggtheme
) +
geom_text_repel(
aes(label = labs_kmeans),
vjust = "inward",
hjust = "inward",
max.overlaps = 14,
size = 2,
seed = 12927
) +
labs(
title = glue::glue("{names(km_result)}")
) +
theme(axis.title = element_text(size = 12))
}
# We will test a range of clusters
CLUSTERS <- 3:10
# k-means on base data
# TODO: TRY THIS WITH fpc::kmeansruns
# Create a function to use on each number of clusters and dataset
run_kmeans <- function(data, clusters) {
km_result <- list(kmeans(data, centers = clusters, nstart = 50))
names(km_result) <- glue::glue("kmeans-{clusters}-clusters")
# plot the result when it is generated
custom_fviz_clust(kmeans[[1]], data)
km_result
}
View(object)
fviz_dist(object$custom$cosine)
fviz_dist(object$custom$pearson)
fviz_dist(object$custom$spearman)
fviz_dist(object$custom$kendall)
fviz_dist(object$custom$euclidean)
fviz_dist(object$custom$maximum)
fviz_dist(object$custom$minmax)
plot(hclust(object$custom$minmax))
plot(hclust(object$custom$minmax, method = "ward"))
# k-means on base data
# TODO: TRY THIS WITH fpc::kmeansruns
# Create a function to use on each number of clusters and dataset
run_kmeans <- function(data, clusters) {
km_result <- list(kmeans(data, centers = clusters, nstart = 50))
names(km_result) <- glue::glue("kmeans-{clusters}-clusters")
# plot the result when it is generated
custom_fviz_clust(kmeans[[1]], data)
km_result
}
# Iterate over each potential number of clusters, then each dataset
kmeans <- map(CLUSTERS, function(numclust) imodify(object, ~ run_kmeans(.x[[1]], numclust)))
