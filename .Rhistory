feature_set_sizes <- seq(from = 50, to = 500, by = 50)
# Note: for testing, I am going to replace the above variable
feature_set_sizes <- 50
n_trials <- 10000
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
for (sample_n in feature_set_sizes) {
features <- sample(colnames(gorman.vars), size = sample_n)
sub_gorman.vars <- gorman.vars[,features]
gorman_dist <- get_dist(sub_gorman.vars, method = "spearman") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- gorman_dist[caesar_all,c(cicero_all, sallust_all)] %>% min(na.rm = TRUE) # na.rm shouldn't be necessary...
stat_cicero <- gorman_dist[cicero_all,c(caesar_all, sallust_all)] %>% min(na.rm = TRUE)
stat_sallust <- gorman_dist[sallust_all,c(cicero_all, caesar_all)] %>% min(na.rm = TRUE)
final_stat <- sum(c(stat_cicero, stat_caesar, stat_sallust))
if (final_stat > max(scores)) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
