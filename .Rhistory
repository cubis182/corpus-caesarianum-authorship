par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_4"],dist_lookup_table["amicitia_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# Another top one:
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_3"],dist_lookup_table["deiotaro_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
gorman.vars %<>% reorder_works()
feature_set_sizes <- seq(from = 25, to = 500, by = 25)
feature_set_sizes <- 100
record_of_scores <- data.frame(set_size = integer(), score = double())
ideal_set <- function(feature_set_sizes, n_trials) {
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
# NOTE: THIS CODE ASSUMES `gorman.vars` STILL HAS THE $TITLE COLUMN!!!
gorman.vars.mat <- as.matrix(gorman.vars[,-1])
rownames(gorman.vars.mat) <- gorman.vars$title
gorman.vars$title <- NULL
columns <- colnames(gorman.vars)
list_features <- map(as.data.frame(combn(columns, length(columns) - 1)), ~ .x)# sample(colnames(gorman.vars.mat), size = sample_n)
for (features in list_features) {
# sub_gorman.vars <- gorman.vars %>%
#  column_to_rownames("title")
sub_gorman.vars <- gorman.vars.mat[,features]
gorman_dist <- get_dist(as.matrix(sub_gorman.vars), method = "pearson") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- (gorman_dist[caesar_all, sallust_all] %>% min(na.rm = TRUE)) # na.rm shouldn't be necessary...
# gorman_dist[caesar_all,cicero_all] %>% min(na.rm = TRUE)
stat_cicero <- 1 - (gorman_dist[cicero_all,cicero_all] %>% max(na.rm = TRUE))
stat_sallust <- 1 - (gorman_dist[sallust_all, sallust_all] %>% max(na.rm = TRUE))
#browser()
final_stat <- sum(c(stat_caesar, stat_cicero, stat_sallust))
if (final_stat > suppressWarnings(max(scores))) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
record_of_scores <<- rbind(record_of_scores, data.frame(set_size = length(best_set), score = best_score))
best_set
}
gorman.vars <- gorman.vars %>% discard(~ if (is.numeric(.x)) sum(.x) == 0 else FALSE)
system.time({
# Count down from 250 to a smaller number, like 10.
# On each iteration, update gorman.vars with the new set and try a smaller set of combinations
target_feature_set_size <- 100
iterations <- ncol(gorman.vars) - target_feature_set_size
record_of_matrices <- array(
dim = c(
nrow(gorman.vars),
nrow(gorman.vars),
iterations
)
)
record_matrix_depth <- 1
while (ncol(gorman.vars) > target_feature_set_size) {
best_set <- ideal_set(feature_set_sizes = i, n_trials = i + 1)
gorman.vars <- gorman.vars[c("title", best_set)]
# Save the dissimilarity matrix, so we can look at the variation as we change the number of features
record_of_matrices[,,record_matrix_depth] <- as.matrix(get_dist(gorman.vars[,-1], method = params$dist_method))
record_matrix_depth <- record_matrix_depth + 1
}
})
# For visualizing the variation
y <- 37:1
x <- 1:37
indexing_vector_y <- map(y, ~ .x:1) %>% unlist()
indexing_vector_x <- map(x, ~ rep(.x, length(x) - (.x - 1) )) %>% unlist()
indexing_matrix <- matrix(c(indexing_vector_x, indexing_vector_y), nrow = length(indexing_vector_x), ncol = 2)
dist_lookup_table <- setNames(1:37, gorman.vars$title)
# The lookup table just above makes it so that you can do
#   `record_of_matrices[dist_lookup_table["gallic_1"],dist_lookup_table["amicitia_1],]`
# in order to find a specific (set) of cells
anon <- function(coord) {
setNames(sd(record_of_matrices[coord[1], coord[2],]), paste(names(dist_lookup_table[coord]), collapse = "|"))
}
test <- apply(indexing_matrix, MARGIN=1, FUN = anon, simplify = FALSE) %>% unlist() # How can I attach each of these to a text?
# Here are the text combinations with the greatest standard deviation over the course of feature culling
sort(test, decreasing = TRUE)[1:20]
par(las = 2) # make the axis lables perpendicular to axis
# The top one, amicitia_1 and gallic_2, visualized; from left to right proceeds through time
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_2"],dist_lookup_table["amicitia_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# Second
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_3"],dist_lookup_table["amicitia_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# A BIG elbow is visible between gallic war and Cicero after about 600 iterations in both the above, so around 150 variables. This indicates to me that the max should be less than that.
# Third
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_2"],dist_lookup_table["philippics_5"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# Starts climbing before 600 iterations, but only climbs sharply at about 600 to 625; keeps climbing after iteration 700
# Fourth
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_2"],dist_lookup_table["brutus_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# Fifth
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_2"],dist_lookup_table["philippics_3"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# Sixth
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_4"],dist_lookup_table["amicitia_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
# doesn't climb until 650
# Another top one:
par(las = 2); plot(record_of_matrices[dist_lookup_table["gallic_3"],dist_lookup_table["deiotaro_1"],], type = "l"); axis(side = 1, seq(0, 750, by = 25));
