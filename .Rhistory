# For converting to readable names in graph labels.
lookup_table <- setNames(
c("BAlex. 1-21", "BAlex. 22-78", "BAfr.", "De Amicitia", "BC 1", "BC 2", "BC 3", "BG 1", "BG 2", "BG 3", "BG 4", "BG 5", "BG 6", "BG 7", "BG 8", "Philippics 1", "Philippics 2", "Philippics 3", "Philippics 4", "Philippics 5", "Philippics 6", "Philippics 7", "Philippics 8", "Philippics 9", "Philippics 10", "Philippics 11", "Philippics 12", "Philippics 13", "Philippics 14", "De Senectute", "BHisp.", "pro Rege Deiotaro", "Brutus", "Catilinae Coniuratio", "Bellum Iugurthinum", "pro Ligario", "pro Marcello"),
c("alexandrine_1", "alexandrine_2", "african_1", "amicitia_1", "civil_1", "civil_2", "civil_3", "gallic_1", "gallic_2", "gallic_3", "gallic_4", "gallic_5", "gallic_6", "gallic_7", "gallic_8", "philippics_1", "philippics_2", "philippics_3", "philippics_4", "philippics_5", "philippics_6", "philippics_7", "philippics_8", "philippics_9", "philippics_10", "philippics_11", "philippics_12", "philippics_13", "philippics_14", "senectute_1", "spanish_1", "deiotaro_1", "brutus_1", "catilinae_sallusti", "iugurthine_1", "ligario_1", "marcello_1")
)
feature_set_sizes <- seq(from = 25, to = 500, by = 25)
feature_set_sizes <- 100
record_of_scores <- data.frame(set_size = integer(), score = double())
ideal_set <- function(feature_set_sizes, n_trials) {
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
# NOTE: THIS CODE ASSUMES `gorman.vars` STILL HAS THE $TITLE COLUMN!!!
gorman.vars.mat <- as.matrix(gorman.vars[,-1])
rownames(gorman.vars.mat) <- gorman.vars$title
gorman.vars$title <- NULL
columns <- colnames(gorman.vars)
list_features <- map(as.data.frame(combn(columns, length(columns) - 1)), ~ .x)# sample(colnames(gorman.vars.mat), size = sample_n)
for (features in list_features) {
# sub_gorman.vars <- gorman.vars %>%
#  column_to_rownames("title")
sub_gorman.vars <- gorman.vars.mat[,features]
gorman_dist <- get_dist(as.matrix(sub_gorman.vars), method = "pearson") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- (gorman_dist[caesar_all, sallust_all] %>% min(na.rm = TRUE)) # na.rm shouldn't be necessary...
# gorman_dist[caesar_all,cicero_all] %>% min(na.rm = TRUE)
stat_cicero <- 1 - (gorman_dist[cicero_all,cicero_all] %>% max(na.rm = TRUE))
stat_sallust <- 1 - (gorman_dist[sallust_all, sallust_all] %>% max(na.rm = TRUE))
#browser()
final_stat <- sum(c(stat_caesar, stat_cicero, stat_sallust))
if (final_stat > suppressWarnings(max(scores))) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
record_of_scores <<- rbind(record_of_scores, data.frame(set_size = length(best_set), score = best_score))
best_set
}
gorman.vars <- gorman.vars %>% discard(~ if (is.numeric(.x)) sum(.x) == 0 else FALSE)
system.time({
# Count down from 250 to a smaller number, like 10.
# On each iteration, update gorman.vars with the new set and try a smaller set of combinations
while (ncol(gorman.vars) > 25) {
best_set <- ideal_set(feature_set_sizes = i, n_trials = i + 1)
gorman.vars <- gorman.vars[c("title", best_set)]
}
})
gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
gorman.vars %<>% reorder_works()
feature_set_sizes <- seq(from = 25, to = 500, by = 25)
feature_set_sizes <- 100
record_of_scores <- data.frame(set_size = integer(), score = double())
ideal_set <- function(feature_set_sizes, n_trials) {
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
# NOTE: THIS CODE ASSUMES `gorman.vars` STILL HAS THE $TITLE COLUMN!!!
gorman.vars.mat <- as.matrix(gorman.vars[,-1])
rownames(gorman.vars.mat) <- gorman.vars$title
gorman.vars$title <- NULL
columns <- colnames(gorman.vars)
list_features <- map(as.data.frame(combn(columns, length(columns) - 1)), ~ .x)# sample(colnames(gorman.vars.mat), size = sample_n)
for (features in list_features) {
# sub_gorman.vars <- gorman.vars %>%
#  column_to_rownames("title")
sub_gorman.vars <- gorman.vars.mat[,features]
gorman_dist <- get_dist(as.matrix(sub_gorman.vars), method = "pearson") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- (gorman_dist[caesar_all, sallust_all] %>% min(na.rm = TRUE)) # na.rm shouldn't be necessary...
# gorman_dist[caesar_all,cicero_all] %>% min(na.rm = TRUE)
stat_cicero <- 1 - (gorman_dist[cicero_all,cicero_all] %>% max(na.rm = TRUE))
stat_sallust <- 1 - (gorman_dist[sallust_all, sallust_all] %>% max(na.rm = TRUE))
#browser()
