longest
longest <- map_int(scores.correlation.per.text, ~ length(.x)) %>% max()
even_out <- function(.x) {
if(length(.x) < longest) {
c(.x, rep(NA, longest - length(.x)))
} else .x
}
scores.correlation.per.text %<>% map(even_out)
diss_scores_df <- do.call(data.frame, scores.correlation.per.text)
View(diss_scores_df)
?pivot_longer
diss_scores_pivoted <- diss_scores_df %>% pivot_longer(cols = everything(), names_to = "title", values_to = "dissimilarities", values_drop_na = TRUE)
