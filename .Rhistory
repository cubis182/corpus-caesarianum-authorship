file.vars.gorman <- if (params$use_parent) "./feature_csv_files/feature_values_gorman.csv" else "./feature_csv_files/feature_values_wordonly.csv"
# Used to select subsets of Gorman variables
load("best_feature_set.RData")
subset_of_corpus <- c("title", best_set) # c(1,250:500)
gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
# for this next adjustment, see Obsidian notebook 8/29/2026
# gorman.vars <- gorman.vars[,subset_of_corpus]
# I have decided to z-standardize instead 9/26/2026
# gorman.vars %<>% scale_df()
# gorman.vars <- gorman.vars[,subset_of_corpus]
caesar.gorman.vars <- gorman.vars %>%
filter(!str_starts(title, cicero_works) & !str_starts(title, sallust_works))
file.sectioned.gorman <- if (params$use_parent) "./feature_csv_files/feature_values_gorman_by_section.csv" else "./feature_csv_files/feature_values_wordonly_by_section.csv"
sectioned.gorman.vars <- read.csv(file.sectioned.gorman);sectioned.gorman.vars$title <- gsub(" ", "", sectioned.gorman.vars$title)
sectioned.gorman.vars <- sectioned.gorman.vars[,subset_of_corpus]
# standardize
# sectioned.gorman.vars %<>% scale_df()
# Add new feature set here, both book-by-book and section-by-section
# Add new feature set COMBINED with morph n-grams (without parent features or Deprel)
# Set of variables combining vocabulary and POS n-grams
custom_vars_book <- read.csv("feature_csv_files/feature_values_custom_by_book.csv")
custom_vars_section <- read.csv("feature_csv_files/feature_values_custom_by_section.csv")
custom_caesar_book <- custom_vars_book %>%
filter(!str_starts(title, cicero_works) & !str_starts(title, sallust_works))
sectioned.gorman.vars %<>% reorder_works()
gorman.vars %<>% reorder_works()
custom_vars_book %<>% reorder_works()
custom_vars_section %<>% reorder_works()
feature_set_sizes <- seq(from = 25, to = 500, by = 25)
feature_set_sizes <- seq(from = 25, to = 100, by = 25)
n_trials <- 10000
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
for (sample_n in feature_set_sizes) {
for (trial in 1:n_trials) {
features <- sample(colnames(gorman.vars %>% select(where(is.numeric))), size = sample_n)
sub_gorman.vars <- gorman.vars %>%
column_to_rownames("title")  %>%
select(all_of(features))
gorman_dist <- get_dist(sub_gorman.vars, method = "pearons") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- gorman_dist[caesar_all,cicero_all] %>% min(na.rm = TRUE) # na.rm shouldn't be necessary...
# stat_cicero <- gorman_dist[cicero_all,c(caesar_all, sallust_all)] %>% min(na.rm = TRUE)
# stat_sallust <- gorman_dist[sallust_all,c(cicero_all, caesar_all)] %>% min(na.rm = TRUE)
final_stat <- sum(c(stat_caesar))
if (final_stat > suppressWarnings(max(scores))) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
}
