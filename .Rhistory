kmeans_results <- imap(object, run_kmeans) |>
unlist(recursive = FALSE)
# Run each data set through PCA, to see which data sets have problems with dimensionality reduction.
# Use R-mode PCA with prcomp(), since Q-mode with princomp() is requires at least as many observations as variables
run_pca <- function(data, name) {
structure(
prcomp(data),
dataset = name
)
}
pca_results <- imap(object, run_pca)
# Get the cumulative proportion of variance for the first two principal components of each one
map(pca_results, ~ summary(.x)$importance[2,1:2] |> sum())
# Highest cumulative proportion of variance is in the Gorman-only section of Caesar at 0.85579, while the lowest is caesar_simplex with 0.69492. Gorman's method is the only one that explains the variance in the data well with both the full corpus AND Caesar's texts alone. When combining the custom variable set WITH Gorman's features, we don't get any improvement.
