run_pam <- function(dist, clusters, metric) {
browser()
pam_result <- pam(dist, clusters) # all other default parameters can be ignored for a dissimilarity matrix
names(pam_result) <- glue::glue("pam-{metric}-{clusters}-clusters")
pam_result
}
for (numclust in CLUSTERS) {
for (metric in names) {
pams <- list(
pams,
map(object, ~ run_pam(pluck(.x, metric)[[1]], numclust, metric))
)
}
}
View(dist)
for (numclust in CLUSTERS) {
for (metric in names) {
pams <- list(
pams,
map(object, ~ run_pam(pluck(.x, metric), numclust, metric))
)
}
}
View(dist)
class(dist)
