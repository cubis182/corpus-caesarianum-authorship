gorman.vars <- read_csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
# for this next adjustment, see Obsidian notebook 8/29/2026
# gorman.vars <- gorman.vars[,subset_of_corpus]
# I have decided to z-standardize instead 9/26/2026
# gorman.vars %<>% scale_df()
gorman.vars <- gorman.vars[,subset_of_corpus]
caesar.gorman.vars <- gorman.vars %>%
filter(!str_starts(title, cicero_works) & !str_starts(title, sallust_works))
file.sectioned.gorman <- if (params$use_parent) "./feature_csv_files/feature_values_gorman_by_section.csv" else "./feature_csv_files/feature_values_wordonly_by_section.csv"
sectioned.gorman.vars <- read_csv(file.sectioned.gorman);sectioned.gorman.vars$title <- gsub(" ", "", sectioned.gorman.vars$title)
sectioned.gorman.vars <- sectioned.gorman.vars[,subset_of_corpus]
# standardize
# sectioned.gorman.vars %<>% scale_df()
# Add new feature set here, both book-by-book and section-by-section
# Add new feature set COMBINED with morph n-grams (without parent features or Deprel)
# Set of variables combining vocabulary and POS n-grams
custom_vars_book <- read.csv("feature_csv_files/feature_values_custom_by_book.csv")
custom_vars_section <- read.csv("feature_csv_files/feature_values_custom_by_section.csv")
custom_caesar_book <- custom_vars_book %>%
filter(!str_starts(title, cicero_works) & !str_starts(title, sallust_works))
sectioned.gorman.vars %<>% reorder_works()
gorman.vars %<>% reorder_works()
custom_vars_book %<>% reorder_works()
custom_vars_section %<>% reorder_works()
# For converting to readable names in graph labels.
lookup_table <- setNames(
c("BAlex. 1-21", "BAlex. 22-78", "BAfr.", "De Amicitia", "BC 1", "BC 2", "BC 3", "BG 1", "BG 2", "BG 3", "BG 4", "BG 5", "BG 6", "BG 7", "BG 8", "Philippics 1", "Philippics 2", "Philippics 3", "Philippics 4", "Philippics 5", "Philippics 6", "Philippics 7", "Philippics 8", "Philippics 9", "Philippics 10", "Philippics 11", "Philippics 12", "Philippics 13", "Philippics 14", "De Senectute", "BHisp.", "pro Rege Deiotaro", "Brutus", "Catilinae Coniuratio", "Bellum Iugurthinum", "pro Ligario", "pro Marcello"),
c("alexandrine_1", "alexandrine_2", "african_1", "amicitia_1", "civil_1", "civil_2", "civil_3", "gallic_1", "gallic_2", "gallic_3", "gallic_4", "gallic_5", "gallic_6", "gallic_7", "gallic_8", "philippics_1", "philippics_2", "philippics_3", "philippics_4", "philippics_5", "philippics_6", "philippics_7", "philippics_8", "philippics_9", "philippics_10", "philippics_11", "philippics_12", "philippics_13", "philippics_14", "senectute_1", "spanish_1", "deiotaro_1", "brutus_1", "catilinae_sallusti", "iugurthine_1", "ligario_1", "marcello_1")
)
corpus_title <- setNames(
c(rep("Corpus Caesarianum", 15), rep("Cicero", 20), rep("Sallust", 2)),
c("BAlex. 1-21", "BAlex. 22-78", "BHisp.", "BAfr.", "BC 1", "BC 2", "BC 3", "BG 1", "BG 2", "BG 3", "BG 4", "BG 5", "BG 6", "BG 7", "BG 8", "De Amicitia", "Philippics 1", "Philippics 2", "Philippics 3", "Philippics 4", "Philippics 5", "Philippics 6", "Philippics 7", "Philippics 8", "Philippics 9", "Philippics 10", "Philippics 11", "Philippics 12", "Philippics 13", "Philippics 14", "De Senectute", "pro Rege Deiotaro", "Brutus", "pro Ligario", "pro Marcello", "Catilinae Coniuratio", "Bellum Iugurthinum")
)
# Set up a data structure with each data set in it. The varieties with "caesar" or "cicero" in the title are the same as the others with the same name, but are restricted to that author alone.
custom_and_gorman_book <- bind_cols(custom_vars_book |> select(-2:-13), gorman.vars |> select(-title), .name_repair = "unique")
caesar_custom_and_gorman <- custom_and_gorman_book %>% filter(!str_starts(title, cicero_works) & !str_starts(title, sallust_works))
object <- list(
simplex_vars_only,
caesar_simplex_vars,
gorman.vars,
caesar.gorman.vars,
custom_vars_book,
custom_and_gorman_book,
caesar_custom_and_gorman
#custom_caesar_book # No clustering tendency
#sectioned.gorman.vars
)
# We need to add rownames, then convert each to a matrix. This will prepare us for some of the functions coming up, which assume an entirely numeric dataset and assume rownames for graphing and generating a dist object
object %<>% map(~ column_to_rownames(.x, "title"))
object %<>% map(~ as.matrix(.x))
# Add each to a named list
object %<>% map(~ .x)
names(object) <- c("simplex", "caesar_simplex", "gorman", "caesar_gorman", "custom", "custom_&_gorman", "caesar_custom_&_gorman")#, "sectioned")
summary(object)
# Some defaults for the following graphs
# Add this with the + operator to fviz_cluster plots. @param data is the original dataset used for cluster analysis (df_clust in the first case)
cluster_labels <- geom_text_repel(aes(label = rownames(data)), vjust = "inward", hjust = "inward", max.overlaps = 20, size = 3)
# Args for fviz_clust
cbbPalette <- c("#000000", "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7")
geom <- "point"
ellipse.type <- "convex"
# K-means
k <- 3
# Hcut
hc_func <- "agnes"
hc_method <- "ward"
hc_metric <- "euclidean"
cex <- 0.2
# Text labels for distance diagrams. @param label is usually the rownames of a data.frame
margin_size <- 10
distance_labels <- theme(axis.text = element_text(size = 5, vjust = 1), margins = margin(t = margin_size, r = margin_size, b = margin_size, l = margin_size))
# Dendrogram theme
dend_size <- 0.2
dend_theme <- theme(axis.text = element_text(size = dend_size, vjust = 1), margins = margin(t = margin_size, r = margin_size, b = margin_size, l = margin_size))
custom_fviz_clust <- function (km_result, source_data = NULL) {
labs_kmeans <- lookup_table[rownames(source_data)]
fviz_cluster(object = km_result,
source_data,
stand = FALSE,
palette = palette,
geom = geom,
ellipse.type = ellipse.type,
ggtheme = ggtheme
) +
geom_text_repel(
aes(label = labs_kmeans),
vjust = "inward",
hjust = "inward",
max.overlaps = 14,
size = 2,
seed = 12927
) +
labs(
title = glue::glue("{names(km_result)}")
) +
theme(axis.title = element_text(size = 12))
}
#Add a 'path' variable which is just the commentary name
# TODO: Remove this cell, and use the title field instead? Or include this in the following cells
sectioned.gorman.vars %<>%
rowwise() %>%
mutate(path = (strsplit(title, "_") |> unlist())[1:2] |> paste0(collapse = "_")) %>%
relocate(path, .before = 2)
#Get a vector of all the titles2
titles <- unique(sectioned.gorman.vars$path)
#Get the spearman correlation coefficients, add them to a list, with the label being the title
scores.correlation.per.text <- tapply(sectioned.gorman.vars, INDEX = sectioned.gorman.vars$path, FUN = within.book.similarity, rows = 20, type_of_similarity = "spearman")
names(scores.correlation.per.text) <- titles
# NOTE: REDUCING TO VARIABLES 250-500 GETS RESULTS VERY SIMILAR TO WHAT WE GOT WITH THE FULL DATASET, INCLUDING PARENTS, BEFORE; PERHAPS REMOVING THE MOST AND LEAST COMMON WILL HELP MAKE THE PICTURE LESS MUDDY?
if (!is.null(gorman.vars$title)) gorman.vars <- gorman.vars %>% mutate(title = lookup_table[title]) %>% column_to_rownames("title")
gorman_dist <- get_dist(gorman.vars, method = params$dist_method)
#gorman_dist <- proxy::dist(gorman.vars |> dplyr::select(-title), method = "cosine")
#gorman_dist <- get_dist(gorman.vars |> dplyr::select(-title), method = "euclidean")
dist_palette <- brewer.pal(n = 5, "YlOrRd")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph <- plot_dist_corpus_project(gorman_dist, gorman.vars) + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
graph
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = 0.3)
ggsave("Images/dissimilarity_matrix_between_books.png", dpi = "print")
#View(as.data.frame(as.matrix(gorman_dist)))
gorman.vars.2 <- gorman.vars |> rownames_to_column("title") |>  filter(corpus_title[title] == "Corpus Caesarianum") |> column_to_rownames("title")
gorman.vars.2
gorman_dist.2 <- get_dist(gorman.vars.2, method = params$dist_method)
graph <- plot_dist_corpus_project(gorman_dist.2, gorman.vars.2)
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05), limits = c(0, 0.8))
ggsave("Images/dissimilarity_matrix_caesar_only.png", dpi = "print")
plot_dist_corpus_project <- function(gorman_dist, data, cell_text_size = 4) {
attributes(gorman_dist)$Label <- as.factor(attributes(gorman_dist)$Label)
attributes(gorman_dist)$Labels <- as.factor(attributes(gorman_dist)$Labels)
mat <- as.matrix(gorman_dist)
d_long <- expand.grid(Var1 = as.factor(rownames(mat)), Var2 = as.factor(colnames(mat)))
d_long$value <- as.vector(mat)
d_long$value <- round(d_long$value, digits = 2)
d_long$x_axis <- rep(1:nrow(data), times = nrow(data))
d_long$y_axis <- rep(1:nrow(data), each = nrow(data))
d_long <- as.data.frame(d_long)
graph <- fviz_dist(gorman_dist, show_labels = TRUE) + scale_x_discrete(labels = attributes(gorman_dist)$Labels) + scale_y_discrete(labels = attributes(gorman_dist)$Labels)
graph <- graph +
geom_tile(
data = d_long,
aes(x = x_axis, y = y_axis, fill = value),
inherit.aes = FALSE
) +
geom_text(
data = d_long,
aes(x = x_axis, y = y_axis, label = value),
color = "black",
size.unit = "pt",
size = cell_text_size,
inherit.aes = FALSE)
}
