# A map function for each distance metric with different linkage methods
imap(
object,
\(x, y) structure(pvclust(.x, "ward.D2", "euclidean"), dataset = y, method = "ward.D2", metric = "euclidean")
),
imap(
object,
\(x, y) structure(pvclust(.x, "ward.D2", "correlation"), dataset = y, method = "ward.D2", metric = "correlation")
)
)
pvclust_results <- c(
# A map function for each distance metric with different linkage methods
imap(
object,
\(x, y) structure(pvclust(x, "ward.D2", "euclidean"), dataset = y, method = "ward.D2", metric = "euclidean")
),
imap(
object,
\(x, y) structure(pvclust(x, "ward.D2", "correlation"), dataset = y, method = "ward.D2", metric = "correlation")
)
)
# fpc::pamk, which can use average silhouette width OR Calinski-Harabasz index, and the Duda-Hart test to determine whether more than one cluster is necessary.
run_pamk <- function(dist) {
structure(
pamk(dist, krange = CLUSTERS, criterion = "ch", alpha = 0.001),
dataset = attributes(dist)$dataset,
algorithm = "pamk",
metric = attributes(dist)$metric
)
}
pamk_results <- map(metrics, run_pamk)
pamk_results %<>% discard(~ .x$nc == 1)
pamk_datasets <- names(object)[unique(map_int(pamk_results, ~ attributes(.x)$dataset))]
pamk_datasets
