CLUSTERS <- 2:8
# pam with dissimilarity matrix
run_pam <- function(dist) {
map(
CLUSTERS,
~ structure(
pam(dist, k = .x),
dataset = attributes(dist)$dataset,
algorithm = "pam",
metric = attributes(dist)$metric,
centers = .x
))
}
pam_results <- map(metrics, run_pam) %>%
unlist(recursive = FALSE)
# fpc::pamk, which can use average silhouette width OR Calinski-Harabasz index, and the Duda-Hart test to determine whether more than one cluster is necessary.
run_pamk <- function(dist) {
structure(
pamk(dist, krange = CLUSTERS, criterion = "ch", alpha = 0.001, keep.diss = TRUE),
dataset = names(object)[attributes(dist)$dataset],
algorithm = "pamk",
metric = attributes(dist)$metric
)
}
pamk_results <- map(metrics, run_pamk)
pamk_results %<>% discard(~ .x$nc == 1)
# !!! The following variable shows that the Caesar data, in no cases, justified more than one cluster. Not with Gorman, and not with the new custom variables. !!!
pamk_datasets <- unique(map_chr(pamk_results, ~ attributes(.x)$dataset))
# Find out what the average cluster number for each dataset is.
df <- map_df(pamk_results, ~ tibble(dataset = attributes(.x)$dataset, nc = .x$nc, metric = attributes(.x)$metric))
df |>
group_by(dataset) |>
summarize(median_nc = median(nc))
