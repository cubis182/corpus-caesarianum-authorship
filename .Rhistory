custom_caesar_book <- custom_vars_book %>%
filter(!str_starts(title, cicero_works) & !str_starts(title, sallust_works))
sectioned.gorman.vars %<>% reorder_works()
gorman.vars %<>% reorder_works()
custom_vars_book %<>% reorder_works()
