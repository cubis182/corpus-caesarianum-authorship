# RUN VAT HERE BASED ON HOPKINS
# VAT on custom feature set with Caesar:
# fclust::VAT(object$custom_caesar)
# VAT on simplex features with Caesar:
fclust::VAT(object$caesar_simplex)
# There are dark spots, but not strong ones. There appear to be three, or perhaps one large one with two smaller ones.
# VAT on Gorman with Caesar
fclust::VAT(object$caesar_gorman)
# Very strong clustering in four groups here; what about with the whole set of texts?
fclust::VAT(object$gorman)
# Four distinct clusters emerge!
# What if we look at a plot with multiple authors?
fclust::VAT(object$custom)
# The cluster tendency is quite weak, as only one dark grouping in the bottom right is visible, maybe Cicero?
# fpc::clusterbenchstats using a variety of clusterings
# This can be done AFTER measuring cluster tendency.
# We will test a range of clusters
CLUSTERS <- 1:8
#' k-means on base data
#'
#' @param source_data An m x n data frame or matrix
#' @param name The name passed from the "object" list, which is unique to this file.
run_kmeans <- function(source_data, name) {
map(
CLUSTERS,
~ structure(
kmeans(source_data, centers = .x, nstart = 50),
dataset = name,
algorithm = "kmeans",
centers = .x
))
}
# Iterate over each potential number of clusters, then each dataset
# Make sure to pass the name of the dataset AND
kmeans_results <- imap(object, run_kmeans) |>
unlist(recursive = FALSE)
# Run each data set through PCA, to see which data sets have problems with dimensionality reduction.
# Use R-mode PCA with prcomp(), since Q-mode with princomp() is requires at least as many observations as variables
run_pca <- function(data, name) {
structure(
prcomp(data),
dataset = name
)
}
pca_results <- imap(object, run_pca)
# Get the cumulative proportion of variance for the first two principal components of each one
map(pca_results, ~ summary(.x)$importance[2,1:2] |> sum())
# Highest cumulative proportion of variance is in the Gorman-only section of Caesar at 0.85579, while the lowest is caesar_simplex with 0.69492. Gorman's method is the only one that explains the variance in the data well with both the full corpus AND Caesar's texts alone.
View(object$custom)
dim(object$custom)
