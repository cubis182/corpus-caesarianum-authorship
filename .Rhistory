# pam with dissimilarity matrix
run_pam <- function(dist, clusters, metric) {
pam_result <- pam(dist, clusters) # all other default parameters can be ignored for a dissimilarity matrix
names(pam_result) <- glue::glue("pam-{metric}-{clusters}-clusters")
pam_result
}
