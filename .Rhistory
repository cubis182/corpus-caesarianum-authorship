stat_cicero <- 1 - (gorman_dist[cicero_all,cicero_all] %>% max(na.rm = TRUE))
stat_sallust <- 1 - (gorman_dist[sallust_all, sallust_all] %>% max(na.rm = TRUE))
final_stat <- sum(c(stat_caesar, stat_cicero, stat_sallust))
if (final_stat > suppressWarnings(max(scores))) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
}
feature_set_sizes <- seq(from = 25, to = 500, by = 25)
feature_set_sizes <- 100
n_trials <- 10000
best_set <- character(0)
best_score <- double(0)
scores <- double(0) # double(length = n_trials * length(feature_set_sizes))
for (sample_n in feature_set_sizes) {
for (trial in 1:n_trials) {
features <- sample(colnames(gorman.vars %>% select(where(is.numeric))), size = sample_n)
sub_gorman.vars <- gorman.vars %>%
column_to_rownames("title")  %>%
select(all_of(features))
gorman_dist <- get_dist(sub_gorman.vars, method = "pearson") %>%
as.matrix() # convert to matrix for easier subsetting
stat_caesar <- 10 * gorman_dist[caesar_all,c(cicero_all, sallust_all)] %>% min(na.rm = TRUE) # na.rm shouldn't be necessary...
# gorman_dist[caesar_all,cicero_all] %>% min(na.rm = TRUE)
stat_cicero <- 1 - (gorman_dist[cicero_all,cicero_all] %>% max(na.rm = TRUE))
stat_sallust <- 1 - (gorman_dist[sallust_all, sallust_all] %>% max(na.rm = TRUE))
final_stat <- sum(c(stat_caesar, stat_cicero, stat_sallust))
if (final_stat > suppressWarnings(max(scores))) {
best_set <- features
best_score <- final_stat
}
scores <- c(scores, final_stat)
}
}
gorman_best_set <- gorman.vars[,c("title", best_set)] |> column_to_rownames("title")
test <- kmeans(gorman_best_set, centers = 3, nstart = 50)
fviz_cluster(test, gorman_best_set) + labs(title = "(1 - max(Cicero dist))) + (1 - max(Sallust dist)) + min(Caesar to Cicero dist")
gorman_dist <- get_dist(gorman_best_set, method = "pearson")
graph <- plot_dist_corpus_project(gorman_dist, gorman_best_set)
graph + theme(axis.text = element_text(size = 4))
