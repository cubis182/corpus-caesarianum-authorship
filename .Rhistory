source("functions.R")
gorman.vars.2 <- gorman.vars |> rownames_to_column("title") |>  filter(corpus_title[title] == "Corpus Caesarianum") |> column_to_rownames("title")
gorman_dist.2 <- get_dist(gorman.vars.2, method = params$dist_method)
graph <- plot_dist_corpus_project(gorman_dist.2, gorman.vars.2, 6) +
labs(title = "Dissimilarity scores between texts of the *Corpus Caesarianum*", subtitle = "Scores computed with Spearman's ρ") +
theme(plot.title = element_markdown())
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(history_corr), probs = 0.05), limits = c(0, 0.8))
ggsave("Images/dissimilarity_matrix_caesar_only.png", dpi = "print")
