conflict_prefer("filter", "dplyr")
conflicted::conflicts_prefer(combinat::combn)
conflicted::conflicts_prefer(dplyr::select)
#For debugging purposes, here is a vector to save the size of the lower quartile that is discarded when variables are counted. This number is the minimum number of times per 1000 words a variable can occur in that section without getting discarded
lower_quartiles <- vector(mode = "double")
log_threshold(level = DEBUG)
source("functions.R")
gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
gorman.vars %<>% reorder_works()
# Count down from 250 to a smaller number, like 10.
# On each iteration, update gorman.vars with the new set and try a smaller set of combinations
for (i in 999:10) {
best_set <- ideal_set(feature_set_sizes = i, n_trials = i + 1)
gorman.vars <- gorman.vars[c("title", best_set)]
}
View(gorman.vars)
names(gorman.vars)
if (!is.null(gorman.vars$title)) gorman.vars <- gorman.vars %>% mutate(title = lookup_table[title]) %>% column_to_rownames("title")
gorman_dist <- get_dist(gorman.vars, method = "spearman")
dist_palette <- brewer.pal(n = 5, "YlOrRd")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph <- plot_dist_corpus_project(gorman_dist, gorman.vars) + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
graph
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
gorman.vars %<>% reorder_works()
# Count down from 250 to a smaller number, like 10.
# On each iteration, update gorman.vars with the new set and try a smaller set of combinations
for (i in 999:500) {
best_set <- ideal_set(feature_set_sizes = i, n_trials = i + 1)
gorman.vars <- gorman.vars[c("title", best_set)]
}
gorman_best_set <- gorman.vars[,c("title", best_set)] |> column_to_rownames("title")
test <- kmeans(gorman_best_set, centers = 3, nstart = 50)
fviz_cluster(test, gorman_best_set) + labs(title = "(1 - max(Cicero dist))) + (1 - max(Sallust dist)) + min(Caesar to Cicero dist")
gorman_dist <- get_dist(gorman_best_set, method = "spearman")
graph <- plot_dist_corpus_project(gorman_dist, gorman_best_set)
graph + theme(axis.text = element_text(size = 4))
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
