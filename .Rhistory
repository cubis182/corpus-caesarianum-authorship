# Create a function to use on each number of clusters and dataset
run_kmeans <- function(source_data, name) {
map(
CLUSTERS,
~ set_attributes(
kmeans(source_data, centers = .x, nstart = 50),
value = list(
dataset = name,
algorithm = "kmeans",
centers = .x
)))
}
