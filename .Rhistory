gorman.vars <- read.csv(file.vars.gorman); gorman.vars$title <- gsub(" ", "", gorman.vars$title)
# for this next adjustment, see Obsidian notebook 8/29/2026
# gorman.vars <- gorman.vars[,subset_of_corpus]
# I have decided to z-standardize instead 9/26/2026
# gorman.vars %<>% scale_df()
gorman.vars <- gorman.vars[,subset_of_corpus]
sectioned.gorman.vars <- read.csv(file.sectioned.gorman);sectioned.gorman.vars$title <- gsub(" ", "", sectioned.gorman.vars$title)
sectioned.gorman.vars <- read.csv(file.sectioned.gorman);sectioned.gorman.vars$title <- gsub(" ", "", sectioned.gorman.vars$title)
sectioned.gorman.vars <- sectioned.gorman.vars[,subset_of_corpus]
sectioned.gorman.vars %<>% reorder_works()
gorman.vars %<>% reorder_works()
#Add a 'path' variable which is just the commentary name
# TODO: Remove this cell, and use the title field instead? Or include this in the following cells
sectioned.gorman.vars %<>%
rowwise() %>%
mutate(path = (strsplit(title, "_") |> unlist())[1:2] |> paste0(collapse = "_")) %>%
relocate(path, .before = 2)
#Get a vector of all the titles2
titles <- unique(sectioned.gorman.vars$path)
#Get the spearman correlation coefficients, add them to a list, with the label being the title
scores.correlation.per.text <- tapply(sectioned.gorman.vars, INDEX = sectioned.gorman.vars$path, FUN = within.book.similarity, rows = 20, type_of_similarity = "spearman")
names(scores.correlation.per.text) <- titles
# NOTE: REDUCING TO VARIABLES 250-500 GETS RESULTS VERY SIMILAR TO WHAT WE GOT WITH THE FULL DATASET, INCLUDING PARENTS, BEFORE; PERHAPS REMOVING THE MOST AND LEAST COMMON WILL HELP MAKE THE PICTURE LESS MUDDY?
if (!is.null(gorman.vars$title)) gorman.vars <- gorman.vars %>% mutate(title = lookup_table[title]) %>% column_to_rownames("title")
gorman_dist <- get_dist(gorman.vars, method = "spearman")
#gorman_dist <- proxy::dist(gorman.vars |> dplyr::select(-title), method = "cosine")
#gorman_dist <- get_dist(gorman.vars |> dplyr::select(-title), method = "euclidean")
dist_palette <- brewer.pal(n = 5, "YlOrRd")
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph <- plot_dist_corpus_project(gorman_dist, gorman.vars) + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
ggsave("Images/dissimilarity_matrix_between_books_by_correlation.png", dpi = "print")
graph + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = 0.3)
ggsave("Images/dissimilarity_matrix_between_books.png", dpi = "print")
#View(as.data.frame(as.matrix(gorman_dist)))
#Using the 5th percentile here. The 95th percentile is beyond any differences between texts, suggesting that difference doesn't guarantee different authorship. However, below about 0.2 is highly suggestive of same authorship, as that's lower than the lower tail (0.05) of the data
graph <- plot_dist_corpus_project(gorman_dist, gorman.vars) + scale_fill_gradient2(low = dist_palette[1], high = dist_palette[5], midpoint = quantile(unlist(scores.correlation.per.text), probs = 0.05))
graph
