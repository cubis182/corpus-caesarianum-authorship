# cophenetic correlation coefficient; if the correlation isn't high, we have more reason to disregard the data
cophenetic_results <- map(
metrics,
\(x) {
cophenetic(hclust(x, method = "ward.D2"))
}
)
coph_coefficients <- imap_dbl(unname(metrics), \(x, y) cor(x, structure(cophenetic_results[[y]], dataset = attributes(x)$dataset, metric = attributes(x)$metric, )))
length(cophenetic_results)
length(metrics)
coph_coefficients <- imap_dbl(unname(metrics), \(x, y) cor(x, structure(cophenetic_results[[y]], dataset = attributes(x)$dataset, metric = attributes(x)$metric)))
coph_coefficients <- imap_dbl(unname(metrics), \(x, y) structure(cor(x, cophenetic_results[[y]]), dataset = attributes(x)$dataset, metric = attributes(x)$metric))
coph_coefficients <- imap(unname(metrics), \(x, y) structure(cor(x, cophenetic_results[[y]]), dataset = attributes(x)$dataset, metric = attributes(x)$metric))
# Only keep ones with a coefficient > 0.75; in other words, distance matrices with a high correlation with their cophenetic matrices
coph_coefficients %<>% discard(~ .x >= 0.75)
coph_coefficients <- imap(unname(metrics), \(x, y) structure(cor(x, cophenetic_results[[y]]), dataset = attributes(x)$dataset, metric = attributes(x)$metric))
# Only keep ones with a coefficient > 0.75; in other words, distance matrices with a high correlation with their cophenetic matrices
coph_coefficients %<>% keep(~ .x >= 0.75)
coph_coefficients %>% map_chr(~ attributes(.x)$dataset) %>% unique() %>% print()
