# cophenetic correlation coefficient; if the correlation isn't high, we have more reason to disregard the data
cophenetic_results <- map(
metrics,
\(x) {
cophenetic(hclust(x, method = "ward.D2"))
}
)
coph_coefficients <- imap(unname(metrics), \(x, y) structure(cor(x, cophenetic_results[[y]]), dataset = attributes(x)$dataset, metric = attributes(x)$metric))
# Only keep ones with a coefficient > 0.75; in other words, distance matrices with a high correlation with their cophenetic matrices
coph_coefficients %<>% keep(~ .x >= 0.75)
# Print the data sets whose cophenetic coefficients are higher than 0.75
coph_coefficients %>% map_int(~ attributes(.x)$dataset) %>% unique() %>% magrittr::extract(names(object), .) %>% print()
# Print the metrics whose cophenetic coefficients are higher than 0.75; only one is missing
coph_coefficients %>% map_chr(~ attributes(.x)$metric) %>% unique() %>% print()
# cluster.stats(dist, clustering = c(1, 1, 1, 1, 2, 2, 2 ...))
run_stats <- function(dist_matrix, clustering_input) {
structure(
cluster.stats(dist_matrix, clustering_input)
)
}
