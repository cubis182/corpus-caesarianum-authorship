count_ngrams <- function(source_data, pos_ngrams) {
# Split the n_grams
# Turning into a tibble unnecessary, but helps
n <- length(str_split(pos_ngrams[1], "[|]")[[1]])
ngrams_in_section <- feature_ngrams(source_data, "tag", n, "PUNCT", FALSE)
counts <- map_dbl(pos_ngrams, ~ sum(str_count(ngrams_in_section, coll(.x))))
tibble(
pasted = pos_ngrams,
n = counts
)
}
