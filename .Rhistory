hc_method <- "ward"
hc_metric <- "euclidean"
cex <- 0.2
# Text labels for distance diagrams. @param label is usually the rownames of a data.frame
margin_size <- 10
distance_labels <- theme(axis.text = element_text(size = 5, vjust = 1), margins = margin(t = margin_size, r = margin_size, b = margin_size, l = margin_size))
# Dendrogram theme
dend_size <- 0.2
dend_theme <- theme(axis.text = element_text(size = dend_size, vjust = 1), margins = margin(t = margin_size, r = margin_size, b = margin_size, l = margin_size))
custom_fviz_clust <- function (km_result, source_data = NULL) {
labs_kmeans <- lookup_table[rownames(source_data)]
fviz_cluster(object = km_result,
source_data,
stand = FALSE,
palette = palette,
geom = geom,
ellipse.type = ellipse.type,
ggtheme = ggtheme
) +
geom_text_repel(
aes(label = labs_kmeans),
vjust = "inward",
hjust = "inward",
max.overlaps = 14,
size = 2,
seed = 12927
) +
labs(
title = glue::glue("{names(km_result)}")
) +
theme(axis.title = element_text(size = 12))
}
# NOTE: Apply all of these to each frequency measurement used in the previous code block.
# Create a new dissimilarity OR similarity matrix with each distance metric
metrics <- list()
# Removed cosine 8/19/2026, see notes below
# Default methods
methods <- c(
"pearson",
"spearman",
"kendall", #
"euclidean",
#"maximum", # Only considers the distance between the farthest parts of each vector. This results in MORE clusters, but we want to be conservative and account for even low-frequency variables.
"manhattan",
#"canberra", # Will only use Canberra for section-by-section variables, since it is good with sparse vectors
#"binary", # Proportion of values in the vector which are above 0; worthless for the book-by-book variables
"minkowski"
)
for (method in methods) {
tmp <- object %>%
map(\(x) custom_dist(x, method = method)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- method
.x
})
metrics %<>% c(tmp)
}
# minmax
tmp <- object %>%
map(\(x) custom_dist(x, method = minmax)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- "minmax"
.x
})
metrics %<>% c(tmp)
