# Create a new dissimilarity OR similarity matrix with each distance metric
metrics <- list()
# Removed cosine 8/19/2026, see notes below
# Default methods
methods <- c(
"pearson",
"spearman",
"kendall", #
"euclidean",
#"maximum", # Only considers the distance between the farthest parts of each vector. This results in MORE clusters, but we want to be conservative and account for even low-frequency variables.
"manhattan",
#"canberra", # Will only use Canberra for section-by-section variables, since it is good with sparse vectors
#"binary", # Proportion of values in the vector which are above 0; worthless for the book-by-book variables
"minkowski"
)
for (method in methods) {
tmp <- object %>%
map(\(x) custom_dist(x, method = method)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- method
.x
})
metrics %<>% c(tmp)
}
# minmax
tmp <- object %>%
map(\(x) custom_dist(x, method = minmax)) %>%
unname()
tmp %<>% imap(\(.x, .y) {
attr(.x, "dataset") <- .y
attr(.x, "metric") <- "minmax"
.x
})
metrics %<>% c(tmp)
