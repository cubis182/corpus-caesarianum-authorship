columns <- colnames(corresp_error_data |> select(tag:Deprel))
# In each column, go through each unique feature.
# For each unique feature, select all the rows in error_data where it appears (using corresp_error_data)
# Then, use the reduce_error_data function defined in a code block above to get the accuracy (sum / length)
accuracy <- list()
for (name in columns) {
# This function accepts the feature value in x and the feature name (i.e. column name) in y
get_acc <- function(x, y) {
selector <- corresp_error_data[[y]] == x & !is.na(corresp_error_data[[y]])
data <- error_data[selector,y]
# We shouldn't find any NAs, I need to fix it if there are
if (any(is.na(data))) {
rlang::abort(glue("No NAs expected; please remove them from original data.\n NAs found in {x},{y} at indices  {which(is.na(data))}"))
}
tibble(
feature = as.character(y),
value = as.character(x),
accuracy = sum(data) / nrow(data)
)
}
accuracy[[name]] <- list_rbind(map(na.omit(unique(corresp_error_data[[name]])), ~ get_acc(.x, name)))
}
accuracy <- list_rbind(accuracy)
ggplot(accuracy, aes(x = value, y = accuracy)) + geom_bar(stat='identity') + theme(axis.text = element_text(angle = 90, size = 10, hjust = 1))
