# A function would be desirable, you give the full set, and the name of the column you want to single out.
# I would review Gries first, to make sure you use the right test; the K-S test might work.
# corpus_segment needs to be a section of scores.correlation.per.text
ks_test_map <- function(corpus_segment, alternative = "two.sided") {
# corpus_segment is either Cicero texts, or "Caesar"/Sallust
set.seed(sum(utf8ToInt("caesarisfun")))
# na.omit because before this I added NAs to make each vector in the list the same length for easy conversion to a data frame
# jittering is very small to keep roughly the same ranks; as of the .RData saved before 9/26/2026, the smallest differesnce between two values in the `scores.correlation.per.test variable is 1.200001e-08, so 0.00000001200001; the default behavior of jitter uses a factor of less than this value
map(corpus_segment, ~ ks.test(
jitter(na.omit(.x)),
jitter(na.omit(unlist(corpus_segment))),
alternative = alternative
)$p.value
)
}
# I keep the alternative at the default "two.sided"
p_values_ks <- c(
ks_test_map(scores.correlation.per.text[caesar_works_v]),
ks_test_map(
scores.correlation.per.text[
names(scores.correlation.per.text) %notin% c(
caesar_works_v,
"catilinae_sallusti",
"iugurthine_1"
)
]
)
)
# Create a list of colors, so we can color-code based on p-value
# Significant = "red" (i.e. reject hypothesis that they're the same distribution of similarity scores)
# Not significant = "green" (i.e., can't be certain they are from different distributions)
color_convert <- function(x) {
n <- length(x)
significance_threshold <- 0.05 / n
map_chr(x, ~ if (.x < significance_threshold) "red" else "green")
}
colors_ks_test <- color_convert(p_values_ks)
dissimilarity_median <- dissimilarity_median[names(p_values_ks)]
# A function would be desirable, you give the full set, and the name of the column you want to single out.
# I would review Gries first, to make sure you use the right test; the K-S test might work.
# corpus_segment needs to be a section of scores.correlation.per.text
ks_test_map <- function(corpus_segment, alternative = "two.sided") {
# corpus_segment is either Cicero texts, or "Caesar"/Sallust
set.seed(sum(utf8ToInt("caesarisfun")))
# na.omit because before this I added NAs to make each vector in the list the same length for easy conversion to a data frame
# jittering is very small to keep roughly the same ranks; as of the .RData saved before 9/26/2026, the smallest differesnce between two values in the `scores.correlation.per.test variable is 1.200001e-08, so 0.00000001200001; the default behavior of jitter uses a factor of less than this value
map(corpus_segment, ~ ks.test(
jitter(na.omit(.x)),
jitter(na.omit(unlist(corpus_segment))),
alternative = alternative
)$p.value
)
}
# I keep the alternative at the default "two.sided"
p_values_ks <- c(
ks_test_map(scores.correlation.per.text[caesar_works_v]),
ks_test_map(
scores.correlation.per.text[
names(scores.correlation.per.text) %notin% c(
caesar_works_v,
"catilinae_sallusti",
"iugurthine_1"
)
]
)
)
# Create a list of colors, so we can color-code based on p-value
# Significant = "red" (i.e. reject hypothesis that they're the same distribution of similarity scores)
# Not significant = "green" (i.e., can't be certain they are from different distributions)
color_convert <- function(x) {
n <- length(x)
significance_threshold <- 0.05 / n
map_chr(x, ~ if (.x < significance_threshold) "red" else "green")
}
colors_ks_test <- color_convert(p_values_ks)
# Create a list of colors, so we can color-code based on p-value
# Significant = "red" (i.e. reject hypothesis that they're the same distribution of similarity scores)
# Not significant = "green" (i.e., can't be certain they are from different distributions)
color_convert <- function(x) {
n <- length(x)
significance_threshold <- 0.05 / n
map_chr(x, ~ if (.x < significance_threshold) "red" else "green")
}
colors_ks_test <- color_convert(p_values_ks)
dissimilarity_median <- map(scores.correlation.per.text, ~ median(.x, na.rm = TRUE))
print(sort(unlist(dissimilarity_median)))
dissimilarity_median <- dissimilarity_median[names(p_values_ks)]
diss_score_gt_tib <- tibble(
title = names(dissimilarity_median),
dissimilarity = unlist(dissimilarity_median)
)
diss_score_gt_tib %<>%
mutate(title = lookup_table[title])
color_fn <- function(x) colors_ks_test
diss_score_gt_tib |>
gt() |>
data_color(columns = dissimilarity, direction = "column", fn = color_fn)
